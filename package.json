{
  "name": "jdrydn-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run css:watch\" \"bundle exec jekyll serve --livereload\"",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --minify",
    "build:jekyll": "bundle exec jekyll build",
    "build": "pnpm run build:css && pnpm run build:jekyll",
    "css:watch": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --watch"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "concurrently": "^9.2.1",
    "tailwindcss": "^3.4.0"
  }
}
